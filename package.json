{
  "name": "forest-survival",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run dev --workspace @forest-survival/client --",
    "typecheck": "vue-tsc --noEmit -p apps/client/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "test": "vitest run",
    "build:client": "npm run build --workspace @forest-survival/client",
    "build": "npm run typecheck && npm run build:client",
    "check": "npm run typecheck && npm run test && npm run build:client",
    "preview": "npm run preview --workspace @forest-survival/client --"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
